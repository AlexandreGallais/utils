{
  "name": "utils",
  "version": "0.0.0",
  "private": true,
  "description": "Strict TypeScript utilities for high-frequency simulation UIs, copied into the projects that use them.",
  "license": "UNLICENSED",
  "author": "Alexandre GALLAIS",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.spec.json && tsc -p tsconfig.bench.json && tsc -p tsconfig.node.json && tsc -p examples/design-system/tsconfig.json",
    "lint": "ESLINT_INFO_RULES=off eslint . --concurrency auto",
    "lint:strict": "pnpm lint --max-warnings 0",
    "lint:cached": "ESLINT_INFO_RULES=off eslint . --concurrency auto --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:fix": "ESLINT_INFO_RULES=off eslint . --fix",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:strict": "pnpm lint:css --max-warnings 0",
    "lint:css:fix": "stylelint \"**/*.scss\" --fix",
    "lint:editor": "node lint/eslint/setup/editor-settings.mjs",
    "lint:presets": "node scripts/check-lint-presets.mjs",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run --config vitest.bench.config.mts --reporter=verbose",
    "transfer": "node scripts/create-transfer.mjs",
    "docs:catalog": "node scripts/generate-catalog.mjs && prettier --write --log-level warn README.md docs/FUNCTIONS.md",
    "check": "pnpm docs:catalog && pnpm wiki:generate && pnpm typecheck && pnpm lint:strict && pnpm lint:css:strict && pnpm lint:presets && pnpm format:check && pnpm knip && pnpm coverage",
    "knip": "knip",
    "wiki:data": "vitest run --coverage --reporter=dot --reporter=json --outputFile.json=coverage/test-results.json",
    "wiki:generate": "node scripts/generate-wiki.mjs",
    "wiki:dev": "pnpm wiki:generate && vitepress dev docs",
    "wiki:build": "pnpm wiki:data && pnpm wiki:generate && vitepress build docs && node scripts/copy-coverage.mjs",
    "wiki:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@angular/common": "22.2.0",
    "@angular/core": "22.2.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@ngrx/signals": "22.0.1",
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "playwright": "1.63.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.9",
    "rxjs": "7.8.2",
    "sass": "1.105.1",
    "stylelint": "17.15.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitepress": "1.6.4",
    "vitest": "5.0.2"
  }
}
