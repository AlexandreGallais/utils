{
  "name": "utils",
  "version": "0.0.0",
  "description": "Strict, dependency-free TypeScript utilities for high-frequency simulation UIs.",
  "license": "UNLICENSED",
  "author": "Alexandre GALLAIS",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json && tsc -p tsconfig.bench.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "pnpm build && vitest bench --run --experimental.viteModuleRunner=false",
    "size": "size-limit",
    "docs:catalog": "node scripts/generate-catalog.mjs && prettier --write --log-level warn README.md docs/FUNCTIONS.md",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "check": "pnpm docs:catalog && pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm coverage && pnpm build && pnpm check:package && pnpm size",
    "prepublishOnly": "pnpm check",
    "knip": "knip"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@size-limit/preset-small-lib": "14.1.0",
    "@types/node": "^24.19.0",
    "@typescript-eslint/utils": "8.71.0",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "size-limit": "14.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
