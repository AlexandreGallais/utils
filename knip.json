{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "benchmarks/*.bench.ts",
    "scripts/*.mjs",
    "docs/.vitepress/config.mts",
    "lint/**/*.mjs",
    "examples/*/src/**/*.ts",
    "examples/*/*.config.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "benchmarks/**/*.ts",
    "scripts/*.mjs",
    "docs/.vitepress/*.mts",
    "*.{mjs,mts}",
    "lint/**/*.mjs",
    "examples/*/src/**/*.ts",
    "examples/*/*.config.mjs"
  ]
}
