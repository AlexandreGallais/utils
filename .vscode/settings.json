    {
      "rule": "no-return-assign",
      "severity": "info"
    },
    {
      "rule": "no-sequences",
      "severity": "info"
    },
    {
      "rule": "no-useless-call",
      "severity": "info"
    },
    {
      "rule": "no-useless-concat",
      "severity": "info"
    },
    {
      "rule": "no-useless-constructor",
      "severity": "info"
    },
    {
      "rule": "no-useless-escape",
      "severity": "info"
    },
    {
      "rule": "no-void",
      "severity": "info"
