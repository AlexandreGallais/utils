    {
      "rule": "@typescript-eslint/no-shadow",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-this-alias",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-parameter-property-assignment",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-constraint",
      "severity": "info"
