{
  "[json][jsonc][yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript][typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.removeUnusedImports": "explicit"
    }
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "eslint.rules.customizations": [
    {
      "rule": "@angular-eslint/component-max-inline-declarations",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/no-empty-lifecycle-method",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/prefer-host-metadata-property",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/prefer-inject",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/prefer-output-emitter-ref",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/prefer-output-readonly",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/prefer-standalone",
      "severity": "info"
    },
    {
      "rule": "@angular-eslint/relative-url-prefix",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/adjacent-overload-signatures",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/class-methods-use-this",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/default-param-last",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/max-params",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/member-ordering",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-dynamic-delete",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-empty-function",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-empty-object-type",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-explicit-any",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-extraneous-class",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-invalid-void-type",
      "severity": "info"
    },
    {
      "rule": "@typescript-eslint/no-namespace",
      "severity": "info"
